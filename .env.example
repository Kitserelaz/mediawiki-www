COMPOSE_PROJECT_NAME=cloudwiki
MW_ENV=development
# image uses packaged code; bind uses read-only host source through scripts/farm.
MW_CODE_MODE=image
# Production bind strategy: versioned (default), or explicitly opt in to live checkout editing.
MW_BIND_STRATEGY=versioned
# MW_SOURCE_DIRECTORY=/absolute/path/to/this/project
MW_DOMAIN=localhost
MW_BETA_DOMAIN=beta.localhost
MW_REALM=default
MW_SMTP_HOST=mailpit
MW_SMTP_PORT=1025
MW_SEARCH=0
MW_IMAGE=cloudwiki-php:local
# Optional independent chron rollout; defaults to MW_IMAGE.
# JOBCHRON_IMAGE=cloudwiki-php:local
WEB_IMAGE=cloudwiki-web:local
COUNTER_IMAGE=cloudwiki-counter:local
# Development binds to loopback; production override explicitly publishes publicly.
HTTP_BIND=127.0.0.1
ADMIN_USER=Admin

# Optional external MongoDB; keep a single counter instance.
COUNTER_DB_TYPE=sqlite
# COUNTER_DB_URL=mongodb://your-internal-mongodb/counter

# Remote Commons/media repositories require explicit opt-in locally.
MW_REMOTE_REPOSITORIES=0
# Absolute container paths; Compose mounts the persistent volumes here.
MW_UPLOAD_ROOT=/var/www/mediawiki/images
MW_DUMP_DIRECTORY=/var/www/dumps

FARM_SECRETS_DIRECTORY=./docker/secrets
MW_EMAIL_ENABLED=1
MW_SSL_REQUESTS=0

# Optional external integrations require explicit opt-in and runtime credentials.
MW_ANALYTICS=0
MW_NOTIFICATIONS=0
MW_CACHE_PURGE=0
MW_CAPTCHA=0
