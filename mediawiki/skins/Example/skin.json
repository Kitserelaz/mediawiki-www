{
	"name": "Example",
	"version": "1.0.0",
	"author": [
		"..."
	],
	"url": "https://www.mediawiki.org/wiki/Skin:Example",
	"descriptionmsg": "example-skin-desc",
	"namemsg": "skinname-example",
	"license-name": "CC0-1.0",
	"type": "skin",
	"AutoloadClasses": {
		"MediaWiki\\Skins\\Example\\SkinExample": "includes/SkinExample.php",
		"MediaWiki\\Skins\\Example\\WikiNavigation": "includes/WikiNavigation.php"
	},
	"requires": {
		"MediaWiki": ">= 1.46"
	},
	"ValidSkinNames": {
		"example": {
			"class": "MediaWiki\\Skins\\Example\\SkinExample",
			"args": [
				{
					"name": "example",
					"responsive": true,
					"templateSectionLinks": "SectionLinks",
					"menus": [
						"user-page",
						"notifications",
						"associated-pages",
						"variants",
						"views",
						"actions",
						"user-interface-preferences",
						"languages",
						"user-menu"
					],
					"messages": [
						"example-no-categories",
						"sitetitle",
						"search",
						"otherlanguages",
						"tagline",
						"navigation-heading",
						"mainpage",
						"categories",
						"example-skip",
						"example-top-navigation",
						"example-pages",
						"example-discuss",
						"example-theme-light",
						"example-theme-dark",
						"example-width",
						"example-save",
						"example-page-tools",
						"example-sign-in",
						"example-create-account",
						"example-home",
						"example-explore",
						"example-saved",
						"example-progress",
						"example-history",
						"example-utilities",
						"example-network",
						"example-settings",
						"example-more",
						"example-in-categories",
						"example-user-menu",
						"example-recent-activity",
						"example-my-tools",
						"example-customize",
						"example-shortcuts",
						"toc",
						"recentchanges",
						"watchlist",
						"close",
						"example-notifications",
						"example-ranks"
					],
					"styles": [
						"skins.example.styles"
					],
					"scripts": [
						"skins.example"
					]
				}
			]
		}
	},
	"MessagesDirs": {
		"Example": [
			"i18n"
		]
	},
	"ResourceModules": {
		"skins.example.styles": {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": {
				"normalize": true,
				"elements": true,
				"content-tables": true,
				"content-links": false,
				"content-media": false,
				"content-links-external": false,
				"interface-category": false,
				"toc": true
			},
			"styles": [
				"resources/fonts.css",
				"resources/fandom-theme.css",
				"resources/fandom-desktop.css",
				"resources/skin.css"
			]
		},
		"skins.example": {
			"packageFiles": [
				"resources/skin.js"
			],
			"dependencies": [
				"mediawiki.storage",
				"jquery.makeCollapsible",
				"mediawiki.api",
				"mediawiki.util"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Example"
	},
	"ResourceModuleSkinStyles": {
		"example": {
			"+ext.echo.styles.badge": "resources/extensions/echo.styles.badge.less"
		}
	},
	"manifest_version": 2
}
