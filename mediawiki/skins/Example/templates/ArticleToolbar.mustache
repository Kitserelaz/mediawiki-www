<div class="WikiaBar example-article-toolbar" aria-label="{{msg-example-my-tools}}" role="navigation">
	{{#watch-action}}<a href="{{url}}">{{label}}</a>{{/watch-action}}
	<button type="button" class="example-page-tools-trigger" data-disclosure="example-page-tools-toggle">{{msg-example-my-tools}}</button>
	<a href="{{preferences-url}}">{{msg-example-customize}}</a>
	<a href="{{watchlist-url}}">{{msg-example-shortcuts}}</a>
	<button type="button" class="example-toolbar-close" aria-label="{{msg-close}}">×</button>
</div>
