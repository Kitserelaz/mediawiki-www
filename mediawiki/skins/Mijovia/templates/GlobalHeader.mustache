<header class="fandom-sticky-header mijovia-guest-header" id="global-top-navigation" data-scroll-navigation aria-label="{{msg-mijovia-top-navigation}}">
	{{>HeaderIdentity}}
	{{>SearchBox}}
	<div class="mijovia-guest-actions">
		{{#talk-url}}<a class="wds-button wds-is-text mijovia-guest-icon mijovia-guest-discuss" href="{{talk-url}}" aria-label="{{msg-mijovia-discuss}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-discussions-small"/></svg></a>{{/talk-url}}
		<button class="wds-button wds-is-text mijovia-guest-icon wiki-tools__theme-switch" type="button" aria-label="{{msg-mijovia-theme-light}}" data-label-light="{{msg-mijovia-theme-light}}" data-label-dark="{{msg-mijovia-theme-dark}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use class="mijovia-theme-dark" href="#wds-icons-sun-small"/><use class="mijovia-theme-light" href="#wds-icons-moon-small"/></svg></button>
		{{#is-anon}}
		<a class="wds-button wds-is-text mijovia-guest-icon" href="{{login-url}}" aria-label="{{msg-mijovia-sign-in}}" title="{{msg-mijovia-sign-in}}"><svg class="wds-icon" aria-hidden="true"><use href="#wds-icons-avatar"/></svg></a>
		{{#register-url}}<a class="wds-button mijovia-guest-register" href="{{register-url}}"><span>{{msg-mijovia-create-account}}</span><span class="mijovia-guest-register-short">{{msg-createaccount}}</span></a>{{/register-url}}
		{{/is-anon}}
		{{^is-anon}}{{#data-portlets.data-user-menu}}{{>Portlet}}{{/data-portlets.data-user-menu}}{{/is-anon}}
	</div>
</header>
