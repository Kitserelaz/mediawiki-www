<div class="page-footer">
	{{#has-page-categories}}
	<details class="wds-collapsible-panel page-footer__categories" open>
		<summary class="wds-collapsible-panel__header">
			{{msg-categories}}
			<svg class="wds-icon wds-icon-small" aria-hidden="true" viewBox="0 0 18 18">
				<path d="m1 5 8 8 8-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</summary>
		<div class="wds-collapsible-panel__content">
			{{{html-categories}}}
		</div>
	</details>
	{{/has-page-categories}}
	{{#has-page-license}}<div id="copyright" class="license-description">{{{html-page-license}}}</div>{{/has-page-license}}
	{{{html-after-content}}}
</div>
