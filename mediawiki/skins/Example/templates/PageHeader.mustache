<div class="page-side-tools__wrapper">
	<div class="page-side-tools">
		<button class="page-side-tool content-size-toggle" type="button" aria-pressed="false" aria-label="{{msg-example-width}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-zoom-in-small"/></svg></button>
		{{#has-page-sections}}
		<div class="sticky-toc-wrapper example-disclosure">
			<button type="button" class="page-side-tool" aria-controls="example-contents" aria-expanded="false" aria-label="{{msg-toc}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-bullet-list-small"/></svg></button>
			<nav id="example-contents" class="example-article-contents" aria-label="{{msg-toc}}" hidden><ul>{{>ArticleSections}}</ul></nav>
		</div>
		{{/has-page-sections}}
		{{#edit-url}}<a class="page-side-tool page-side-edit" href="{{edit-url}}" aria-label="{{edit-label}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-pencil-small"/></svg></a>{{/edit-url}}
		{{#is-article}}<button class="page-side-tool page-side-save" type="button" disabled aria-label="{{msg-example-save}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-ribbon-small"/></svg></button>{{/is-article}}
	</div>
</div>
<div id="page-header" class="page-header{{#signed-in-article}} page-header--new-wiki-nav{{/signed-in-article}}" tabindex="-1">
	<div class="page-header__top">
		<div class="page-header__meta">
			{{#array-indicators}}<span id="{{id}}" class="{{class}}">{{{html}}}</span>{{/array-indicators}}
		</div>
	</div>
	<div class="page-header__bottom">
		<div class="page-header__title-wrapper">
			<h1 id="firstHeading" class="page-header__title firstHeading mw-first-heading" {{#is-title-blank}}hidden{{/is-title-blank}} {{{html-user-language-attributes}}}>{{{html-title}}}</h1>
		</div>
		<div id="p-views" class="page-header__actions">
			{{#signed-in-article}}
			<a class="wds-button wds-is-text page-header__action-button page-header__collections has-label" href="{{talk-url}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-comment-small"/></svg><span>{{msg-example-discuss}}</span></a>
			{{/signed-in-article}}
			{{#is-article}}<button class="wds-button wds-is-text page-header__action-button page-header__collections has-label" type="button" disabled><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-ribbon-small"/></svg><span>{{msg-example-save}}</span></button>{{/is-article}}
			{{#edit-url}}<a class="wds-button wds-is-text page-header__action-button has-label{{#signed-in-article}} page-header__collections page-header__edit-action{{/signed-in-article}}" id="example-primary-edit" href="{{edit-url}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-pencil-small"/></svg><span>{{edit-label}}</span></a>{{/edit-url}}
			<div class="wds-dropdown example-disclosure">
				<button class="wds-button wds-is-text wds-dropdown__toggle page-header__action-button" type="button" id="example-page-tools-toggle" aria-controls="example-page-tools" aria-expanded="false" aria-label="{{msg-example-page-tools}}">
					<svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-more-small"/></svg>
				</button>
				<div id="example-page-tools" class="wds-dropdown__content wds-is-right-aligned" hidden>
					{{#data-portlets}}
						<ul class="wds-list wds-is-linked">{{#data-views}}{{{html-items}}}{{/data-views}}</ul>
						{{#data-actions}}{{>Portlet}}{{/data-actions}}
						{{#data-associated-pages}}{{>Portlet}}{{/data-associated-pages}}
						{{#data-variants}}{{>Portlet}}{{/data-variants}}
						{{#data-languages}}{{>Portlet}}{{/data-languages}}
					{{/data-portlets}}
					{{#data-portlets-sidebar.data-portlets-first}}{{>Portlet}}{{/data-portlets-sidebar.data-portlets-first}}
					{{#data-portlets-sidebar.array-portlets-rest}}{{>Portlet}}{{/data-portlets-sidebar.array-portlets-rest}}
				</div>
			</div>
		</div>
	</div>
	{{#signed-in-article}}{{#normal-category-count}}
	<div class="page-header__categories-bar">
		<a class="wds-button wds-is-text wds-dropdown__toggle" href="#catlinks">{{category-count-label}} <svg class="wds-icon wds-icon-tiny" aria-hidden="true"><use href="#wds-icons-dropdown-tiny"/></svg></a>
	</div>
	{{/normal-category-count}}{{/signed-in-article}}
</div>
