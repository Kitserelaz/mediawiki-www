{{>NavigationIcons}}
{{^signed-in-page}}
<div class="notifications-placeholder">
	{{#data-portlets.data-notifications}}{{>Portlet}}{{/data-portlets.data-notifications}}
</div>
{{/signed-in-page}}
{{^signed-in-page}}{{>GlobalHeader}}{{/signed-in-page}}
{{#signed-in-page}}{{>ArticleNavigation}}{{/signed-in-page}}
<div class="main-container{{#signed-in-page}} mijovia-signed-in-page{{/signed-in-page}}{{#signed-in-home}} mijovia-signed-in-home{{/signed-in-home}}">
	<div class="fandom-community-header__background cover header" style="--image-ratio:0.44829647340108"></div>
	<div class="resizable-container{{#show-article-rail}} resizable-container--has-right-rail{{/show-article-rail}}">
		<a class="mijovia-skip" href="#page-header">{{msg-mijovia-skip}}</a>
		<div class="community-header-wrapper">
			<header class="fandom-community-header{{#no-community-logo}} has-no-logo{{/no-community-logo}}">
				<a class="fandom-community-header__image" href="{{link-mainpage}}"{{#no-community-logo}} hidden{{/no-community-logo}}>
					<img {{#community-logo}}src="{{community-logo}}" {{/community-logo}}data-mijovia-default-logo="{{default-community-logo}}" width="500" height="500" alt="{{msg-sitetitle}}">
				</a>
				<div class="fandom-community-header__top-container">
					<div class="fandom-community-header__community-name-wrapper">
						<a class="fandom-community-header__community-name" href="{{link-mainpage}}">{{msg-sitetitle}}</a>
					</div>
					<div class="page-counter"><a href="{{all-pages-url}}">
						<div class="page-counter__value">{{article-count}}</div>
						<div class="page-counter__label">{{msg-mijovia-pages}}</div>
					</a></div>
					<div class="wiki-tools wds-button-group">
						{{^signed-in-page}}<button class="wds-button wds-is-secondary" type="button" disabled aria-label="{{msg-mijovia-discuss}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-discussions-small"/></svg></button>{{/signed-in-page}}
						{{#signed-in-page}}{{#talk-url}}<a class="wds-button wds-is-secondary" href="{{talk-url}}" aria-label="{{msg-mijovia-discuss}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-discussions-small"/></svg></a>{{/talk-url}}<a class="wds-button wds-is-secondary" href="{{recent-changes-url}}" aria-label="{{msg-recentchanges}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-activity-small"/></svg></a>{{/signed-in-page}}
						<button class="wds-button wds-is-secondary wiki-tools__theme-switch" type="button" aria-label="{{msg-mijovia-theme-light}}" data-label-light="{{msg-mijovia-theme-light}}" data-label-dark="{{msg-mijovia-theme-dark}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use class="mijovia-theme-dark" href="#wds-icons-sun-small"/><use class="mijovia-theme-light" href="#wds-icons-moon-small"/></svg></button>
						{{#signed-in-page}}{{#has-page-actions}}<button type="button" class="wds-button wds-is-secondary mijovia-page-tools-trigger" data-disclosure="mijovia-page-tools-toggle" aria-label="{{msg-mijovia-page-tools}}"><svg class="wds-icon wds-icon-small" aria-hidden="true"><use href="#wds-icons-more-small"/></svg></button>{{/has-page-actions}}{{/signed-in-page}}
					</div>
				</div>
				{{{html-wiki-navigation}}}
			</header>
		</div>
		<div class="page{{#show-article-rail}} has-right-rail{{/show-article-rail}}">
			<main class="page__main">
				{{>PageHeader}}
				<div id="content" class="page-content ve-init-mw-desktopArticleTarget-targetContainer" {{{html-user-language-attributes}}}>
					<div id="siteNotice">{{{html-site-notice}}}</div>
					{{{html-user-message}}}
					<div id="contentSub">{{{html-subtitle}}}{{{html-undelete-link}}}</div>
					{{{html-body-content}}}
				</div>
				{{>PageFooter}}
			</main>
			{{#show-article-rail}}{{>ArticleRail}}{{/show-article-rail}}
		</div>
	</div>
	{{#data-footer}}{{>Footer}}{{/data-footer}}
</div>

{{#signed-in-page}}{{>ArticleToolbar}}{{/signed-in-page}}
