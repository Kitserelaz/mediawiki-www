        "sortBy": [
          {
            "displayName": "CPU %",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "kind": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "renameByName": {
              "service": "Service",
