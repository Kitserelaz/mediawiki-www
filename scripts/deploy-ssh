#!/bin/sh
# This forced SSH command never exposes local configuration-acceptance commands.
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
  deploy-dashboard) exec sudo -n /usr/bin/python3 /usr/local/libexec/cloudwiki-deploy-dashboard.py ;;
  deploy) exec sudo -n /usr/bin/python3 /usr/local/libexec/cloudwiki-deploy-production.py deploy ;;
  *) printf '%s\n' 'Only the deploy command is permitted' >&2; exit 1 ;;
esac
