        "name": "service",
        "label": "Production service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(cloudwiki_service_state{kind=\"container\"}, service)",
        "definition": "label_values(cloudwiki_service_state{kind=\"container\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
