COMPOSE_PROJECT_NAME=cloudwiki-production
COMPOSE_FILE=compose.yaml:compose.production.yaml
FARM_SECRETS_DIRECTORY=./docker/secrets-production
MW_ENV=production
MW_LEGACY_BRANDING=0
MW_EMAIL_ENABLED=0
MW_SSL_REQUESTS=0
MW_DOMAIN=example.org
MW_BETA_DOMAIN=beta.example.org
MW_REALM=default
MW_SMTP_HOST=smtp.example.org
MW_SMTP_PORT=587
MW_SEARCH=0
ACME_EMAIL=admin@example.org
MW_PUBLIC_HOSTS="meta.example.org, login.example.org, auth.example.org, test.example.org"
# Replace these with your immutable registry references after publishing verified images.
MW_IMAGE=cloudwiki-php:local
# Optional independent chron rollout; defaults to MW_IMAGE.
# JOBCHRON_IMAGE=cloudwiki-php:local
WEB_IMAGE=cloudwiki-web:local
COUNTER_IMAGE=cloudwiki-counter:local

# Optional external integrations require explicit opt-in and runtime credentials.
MW_ANALYTICS=0
MW_NOTIFICATIONS=0
MW_CACHE_PURGE=0
MW_CAPTCHA=0
