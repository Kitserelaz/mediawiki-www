(wiki_php_client_ip) {
    env REMOTE_ADDR {client_ip}
    header_up X-Forwarded-For {client_ip}
    header_up -CF-Connecting-IP
    header_up -CF-Connecting-IPv6
    header_up -X-Real-IP
    header_up -Forwarded
}

(wiki) {
    root * /var/www/mediawiki
    encode zstd gzip
    header X-Content-Type-Options nosniff
    route {
        @numericFarmHost {
            host *.{$MW_DOMAIN:localhost} *.{$MW_BETA_DOMAIN:beta.localhost}
            expression `'{$MW_NUMERIC_WIKI_IDS:0}' == '1' && {http.request.host}.matches('^[0-9]+[.]')`
        }
        forward_auth @numericFarmHost 127.0.0.1:8081 {
            uri /route-numeric
            header_up Host 127.0.0.1:8081
            header_up X-CloudWiki-Lookup-Host {http.request.host}
            header_up X-CloudWiki-Lookup-SNI {http.request.tls.server_name}
            header_up X-CloudWiki-Lookup-Scheme {scheme}
            header_up -Cookie
            header_up -Authorization
        }
        @creationEvents path /wiki-creation/events
        reverse_proxy @creationEvents creation-events:8080
        # Only public assets and known entrypoints are exposed. Caddy ignores .htaccess.
        @private path_regexp private (?i)(^/\.|/\.|^/(vendor|includes|maintenance|tests|sql|cache|cw_cache|docker|image-imports|sitemaps|mw-config)(/|$)|^/(LocalSettings|PrivateSettings|GlobalSettings|GlobalCache|GlobalExtensions|ConfigSettings|SkyWikiFunctions|ManageWikiSettings|ManageWikiNamespaces|ManageWikiExtensions|LocalWiki|SetupCreateWiki|db-health|redis-health|smtp-health|honeypot)\.php|\.(key|pem|log|sql|db|rdb|ya?ml|lock|bak|save|tar\.gz)$)
        respond @private 404
        @protectedUpload path_regexp protectedUpload ^/images/[^/]+/(deleted|temp)/
        respond @protectedUpload 404
        # Public assets also use root-relative URLs on the shared-auth domain.
        @assets path /resources/* /skins/* /extensions/*
        handle @assets {
            @assetPhp path_regexp assetPhp (?i)\.php(/|$)
            respond @assetPhp 404
            file_server
        }
        # Shared-auth URLs start with a numeric ID or a legacy wiki database name.
        @auth host auth.{$MW_DOMAIN:localhost}
        handle @auth {
            @authArticle path_regexp authArticle ^/(?:[1-9][0-9]*|[a-z0-9_]+wiki)/wiki/(.*)$
            handle @authArticle {
                rewrite * /index.php?title={re.authArticle.1}&{query}
                php_fastcgi php:9000 {
                    import wiki_php_client_ip
                    env HTTPS on
                    env HTTP_X_FORWARDED_PROTO https
                    env REQUEST_URI {http.request.orig_uri}
                }
            }
            @authEntry path_regexp authEntry ^/(?:[1-9][0-9]*|[a-z0-9_]+wiki)/w/(index|api|load|rest)\.php(/.*)?$
            handle @authEntry {
                rewrite * /{re.authEntry.1}.php{re.authEntry.2}
                php_fastcgi php:9000 {
                    import wiki_php_client_ip
                    env HTTPS on
                    env HTTP_X_FORWARDED_PROTO https
                    env REQUEST_URI {http.request.orig_uri}
                }
            }
            respond 404
        }
        @short path_regexp article ^/wiki/(.*)$
        rewrite @short /index.php?title={re.article.1}&{query}
        @root path /
        rewrite @root /index.php
        @entry path_regexp entry ^/(index|api|load|rest|img_auth|thumb|thumb_handler|opensearch_desc)\.php(/.*)?$
        handle @entry {
            php_fastcgi php:9000 {
                import wiki_php_client_ip
                env CLOUDWIKI_CUSTOM_WIKI {http.vars.cloudwiki_custom_wiki}
                env CLOUDWIKI_CUSTOM_HOST {http.vars.cloudwiki_custom_host}
                env HTTPS on
                env HTTP_X_FORWARDED_PROTO https
                env REQUEST_URI {http.request.orig_uri}
            }
        }
        @php path_regexp php (?i)\.php(/|$)
        respond @php 404
        @upload path_regexp upload ^/images/[^/]+/(.*)$
        handle @upload {
            rewrite * /img_auth.php/{re.upload.1}
            php_fastcgi php:9000 {
                import wiki_php_client_ip
                env CLOUDWIKI_CUSTOM_WIKI {http.vars.cloudwiki_custom_wiki}
                env CLOUDWIKI_CUSTOM_HOST {http.vars.cloudwiki_custom_host}
                env HTTPS on
                env HTTP_X_FORWARDED_PROTO https
                env REQUEST_URI {http.request.orig_uri}
            }
        }
        respond 404
    }
}

# Unpublished port for checking the new wiki through the normal PHP-FPM pool.
http://:8083 {
    @probe {
        method GET
        path /wiki-creation/probe
    }
    route {
        handle @probe {
            rewrite * /api.php?action=query&meta=siteinfo&format=json
            reverse_proxy php:9000 {
                transport fastcgi {
                    root /var/www/mediawiki
                    split .php
                    env HTTPS on
                    env HTTP_X_FORWARDED_PROTO https
                }
            }
        }
        respond 404
    }
}
